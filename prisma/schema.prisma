generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ApiProvider {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(100)
  apiKey    String   @db.Text
  apiSecret String?  @db.Text
  endpoint  String   @db.VarChar(500)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id            String                @id @default(cuid())
  userId        String
  tourId        String
  status        Booking_status        @default(PENDING)
  paymentStatus Booking_paymentStatus @default(PENDING)
  totalAmount   Decimal               @db.Decimal(10, 2)
  externalUrl   String?               @db.VarChar(500)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  Tour          Tour                  @relation(fields: [tourId], references: [id], onDelete: Cascade)
  User          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([tourId])
  @@index([userId])
}

model City {
  id              Int               @id
  countryId       Int
  Country         Country           @relation(fields: [countryId], references: [id])
  CityTranslation CityTranslation[]
  Tour            Tour[]

  @@index([countryId])
}

model CityTranslation {
  id       String @id @default(cuid())
  cityId   Int
  language String @db.VarChar(2)
  name     String @db.VarChar(255)
  City     City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, language])
  @@index([language])
}

model Country {
  id                 Int                  @id
  code               String               @unique @db.VarChar(10)
  City               City[]
  CountryTranslation CountryTranslation[]
  Tour               Tour[]
}

model CountryTranslation {
  id        String  @id @default(cuid())
  countryId Int
  language  String  @db.VarChar(2)
  name      String  @db.VarChar(255)
  Country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, language])
  @@index([language])
}

model LocationProviderMapping {
  id            String   @id @default(cuid())
  provider      String   @db.VarChar(50)
  locationType  String   @db.VarChar(20)
  isoCode       String?  @db.VarChar(2)
  canonicalName String   @db.VarChar(255)
  providerId    String   @db.VarChar(100)
  providerData  Json?
  countryId     Int?
  cityId        Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([provider, locationType, providerId])
  @@index([isoCode, locationType])
  @@index([provider, locationType])
}

model SyncMetadata {
  id         String   @id @default(cuid())
  provider   String   @unique @db.VarChar(100)
  lastSyncAt DateTime
  toursCount Int
  status     String   @db.VarChar(50)
}

model Tour {
  id              String            @id @default(cuid())
  externalId      Int               @unique
  images          Json
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  POIs            Json?
  categoryId      Int
  cityId          Int
  countryId       Int
  duration        String            @db.VarChar(20)
  includes        Json
  meetingPoint    Json
  priceCurrency   String            @db.VarChar(3)
  priceValue      Decimal           @db.Decimal(10, 2)
  providerPhone   String?           @db.VarChar(50)
  providerTitle   String            @db.VarChar(255)
  rating          Decimal?          @db.Decimal(3, 2)
  reviewsNumber   Int               @default(0)
  titleImageURL   String?           @db.Text
  videoURL        String?           @db.Text
  Booking         Booking[]
  City            City              @relation(fields: [cityId], references: [id])
  Country         Country           @relation(fields: [countryId], references: [id])
  TourTranslation TourTranslation[]

  @@index([categoryId])
  @@index([cityId])
  @@index([countryId])
  @@index([isActive])
  @@index([priceValue])
}

model TourTranslation {
  id          String  @id @default(cuid())
  tourId      String
  language    String  @db.VarChar(2)
  title       String  @db.VarChar(500)
  brief       String? @db.Text
  description String? @db.Text
  url         String  @db.Text
  Tour        Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, language])
  @@index([language])
  @@index([title])
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  name      String?   @db.VarChar(255)
  role      User_role @default(CLIENT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Booking   Booking[]
}

enum Booking_status {
  PENDING
  CONFIRMED
  CANCELLED
}

enum User_role {
  CLIENT
  ADMIN
}

enum Booking_paymentStatus {
  PENDING
  PAID
  REFUNDED
}
